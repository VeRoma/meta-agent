spring.application.name=challxbot

# ===================================================================
# DATABASE (PostgreSQL)
# ===================================================================
# Replace 'your_db_name' with the name of your PostgreSQL database.
spring.datasource.url=jdbc:postgresql://localhost:5432/challxbot_db

# Replace 'your_username' with your PostgreSQL username.
spring.datasource.username=postgres

# Replace 'your_password' with your PostgreSQL password.
spring.datasource.password=Fashidoku2905!

spring.datasource.driver-class-name=org.postgresql.Driver

# ===================================================================
# JPA / HIBERNATE
# ===================================================================
# This tells Hibernate to update the database schema on startup (e.g., create missing tables).
spring.jpa.hibernate.ddl-auto=update

# (Optional) Show SQL queries in the console for debugging.
spring.jpa.show-sql=true

spring.jpa.open-in-view=false

