package com.challxbot.service;

import com.challxbot.domain.AppUser;
import com.challxbot.domain.Example;
import com.challxbot.domain.UserProgress;
import com.challxbot.domain.Vocabulary;
import com.challxbot.dto.PendingWord;
import com.challxbot.dto.UserStatistics;
import com.challxbot.repository.ExampleRepository;
import com.challxbot.repository.UserProgressRepository;
import com.challxbot.repository.VocabularyRepository;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;
import org.telegram.telegrambots.bots.TelegramLongPollingBot;
import org.telegram.telegrambots.meta.api.methods.AnswerCallbackQuery;
import org.telegram.telegrambots.meta.api.methods.send.SendMessage;
import org.telegram.telegrambots.meta.api.methods.updatingmessages.DeleteMessage;
import org.telegram.telegrambots.meta.api.methods.updatingmessages.EditMessageReplyMarkup;
import org.telegram.telegrambots.meta.api.methods.updatingmessages.EditMessageText;
import org.telegram.telegrambots.meta.api.objects.CallbackQuery;
import org.telegram.telegrambots.meta.api.objects.Message;
import org.telegram.telegrambots.meta.api.objects.Update;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.InlineKeyboardMarkup;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.buttons.InlineKeyboardButton;
import org.telegram.telegrambots.meta.exceptions.TelegramApiException;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;

@Service
public class TelegramBotService extends TelegramLongPollingBot {

    public enum UserState {
        DEFAULT, WAITING_FOR_WORD_EDIT, WAITING_FOR_TRANS_EDIT, WAITING_FOR_EXAMPLE_EDIT
    }

    private final String botUsername;
    private final VocabularyRepository vocabularyRepository;
    private final UserService userService;
    private final ExampleRepository exampleRepository;
    private final UserProgressRepository userProgressRepository;
    private final AiDictionaryService aiDictionaryService;
    private final Map<Long, Integer> lastMenuMessageIds = new ConcurrentHashMap<>();
    private final Map<Long, QuizSession> activeSessions = new ConcurrentHashMap<>();
    private final Map<Long, UserState> userStates = new ConcurrentHashMap<>();
    private final Map<Long, PendingWord> pendingWords = new ConcurrentHashMap<>();
    private final Map<Long, Integer> promptMessageIds = new ConcurrentHashMap<>();
    private final ScheduledExecutorService scheduler = Executors.newScheduledThreadPool(4);

    private static class QuizSession {
        List<Vocabulary> queue = new ArrayList<>();
        int totalOriginalWords = 0;
        int correctCount = 0;
        Vocabulary previousWord = null;
        boolean wasPreviousCorrect = true;
        String quizName = "Тренировка";
        Integer currentMessageId = null;
        Integer quizLimit = 20;
        Integer sessionMaxWords = 20;
        int sessionCorrectCount = 0;
        int sessionWrongCount = 0;
    }

    public TelegramBotService(
            @Value("${telegram.bot.token}") String botToken,
            @Value("${telegram.bot.username}") String botUsername,
            VocabularyRepository vocabularyRepository,
            UserService userService,
            ExampleRepository exampleRepository,
            UserProgressRepository userProgressRepository,
            AiDictionaryService aiDictionaryService) {
        super(botToken);
        this.botUsername = botUsername;
        this.vocabularyRepository = vocabularyRepository;
        this.userService = userService;
        this.exampleRepository = exampleRepository;
        this.userProgressRepository = userProgressRepository;
        this.aiDictionaryService = aiDictionaryService;
    }

    @Override
    public String getBotUsername() {
        return botUsername;
    }

    private void deleteSessionMessage(Long chatId) {
        QuizSession session = activeSessions.get(chatId);
        if (session != null && session.currentMessageId != null) {
            try {
                execute(new DeleteMessage(String.valueOf(chatId), session.currentMessageId));
            } catch (TelegramApiException e) {
                // silently ignore if already deleted
            }
            session.currentMessageId = null;
        }
    }

    private void clearActiveSession(Long chatId) {
        deleteSessionMessage(chatId);
        activeSessions.remove(chatId);
    }

    private void clearLastMenuMessage(Long chatId) {
        Integer messageId = lastMenuMessageIds.remove(chatId);
        if (messageId != null) {
            try {
                execute(new DeleteMessage(String.valueOf(chatId), messageId));
            } catch (TelegramApiException e) {
                // silently ignore if already deleted
            }
        }
    }

    private void handleResumeQuiz(Long chatId, Long telegramId, String username) {
        QuizSession session = activeSessions.get(chatId);
        AppUser user = userService.getOrCreateUser(telegramId, username);
        
        if (session != null && session.sessionMaxWords != null && user.getMaxSessionWords() != session.sessionMaxWords) {
            int limit = session.quizLimit != null ? session.quizLimit : 20;
            Page<Vocabulary> page = vocabularyRepository.findAll(PageRequest.of(0, limit, Sort.by(Sort.Direction.ASC, "frequency")));
            List<Vocabulary> words = new ArrayList<>(page.getContent());
            
            List<UserProgress> progressList = userProgressRepository.findByUser(user);
            java.util.Map<Long, Integer> wordAttempts = new java.util.HashMap<>();
            List<Vocabulary> unmasteredWords = new ArrayList<>();
            for (Vocabulary v : words) {
                int correct = 0;
                int wrong = 0;
                for (UserProgress p : progressList) {
                    if (p.getVocabulary().getId().equals(v.getId())) {
                        correct = p.getCorrectAnswers();
                        wrong = p.getWrongAnswers();
                        break;
                    }
                }
                if ((correct - wrong) < 2) {
                    unmasteredWords.add(v);
                    wordAttempts.put(v.getId(), correct + wrong);
                }
            }
            
            unmasteredWords.sort((v1, v2) -> {
                int attempts1 = wordAttempts.getOrDefault(v1.getId(), 0);
                int attempts2 = wordAttempts.getOrDefault(v2.getId(), 0);
                if (attempts1 != attempts2) {
                    return Integer.compare(attempts1, attempts2);
                }
                int freq1 = v1.getFrequency() != null ? v1.getFrequency() : Integer.MAX_VALUE;
                int freq2 = v2.getFrequency() != null ? v2.getFrequency() : Integer.MAX_VALUE;
                return Integer.compare(freq1, freq2);
            });
            
            int newLimit = user.getMaxSessionWords();
            if (newLimit > 0 && unmasteredWords.size() > newLimit) {
                unmasteredWords = new ArrayList<>(unmasteredWords.subList(0, newLimit));
            }
            
            Collections.shuffle(unmasteredWords);
            
            session.queue.clear();
            session.queue.addAll(unmasteredWords);
            session.totalOriginalWords = unmasteredWords.size();
            session.correctCount = 0;
            session.sessionCorrectCount = 0;
            session.sessionWrongCount = 0;
            session.previousWord = null;
            session.sessionMaxWords = newLimit;
        }
        
        sendNextSessionQuestion(chatId, null, telegramId, username);
    }

    @Override
    public void onUpdateReceived(Update update) {
        if (update.hasMessage() && update.getMessage().hasText()) {
            Message message = update.getMessage();
            Long chatId = message.getChatId();
            Integer messageId = message.getMessageId();
            Long telegramId = message.getFrom().getId();
            String username = message.getFrom().getUserName();
            String text = message.getText();

            userService.getOrCreateUser(telegramId, username);

            if (text.startsWith("/")) {
                try {
                    execute(new DeleteMessage(String.valueOf(chatId), messageId));
                } catch (TelegramApiException e) {
                    // silently ignore
                }

                deleteSessionMessage(chatId);
                clearLastMenuMessage(chatId);
                userStates.put(chatId, UserState.DEFAULT);
                pendingWords.remove(chatId);

                if (text.equals("/start") || text.equals("/quiz")) {
                    activeSessions.remove(chatId);
                    Message msg = sendQuizMenu(chatId);
                    if (msg != null) {
                        lastMenuMessageIds.put(chatId, msg.getMessageId());
                    }
                } else if (text.equals("/stop")) {
                    activeSessions.remove(chatId);
                    Message msg = sendMessage(chatId, "🛑 Тренировка остановлена. Можешь начать новую через команду /quiz!");
                    if (msg != null) {
                        lastMenuMessageIds.put(chatId, msg.getMessageId());
                    }
                } else if (text.equals("/progress")) {
                    activeSessions.remove(chatId);
                    try {
                        UserService.DashboardStats stats = userService.getDashboardStats(telegramId);
                        String dashboardText = generateProgressDashboard(stats);
                        
                        InlineKeyboardMarkup markup = new InlineKeyboardMarkup();
                        List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();
                        keyboard.add(List.of(createInlineButton("🔄 Обновить", "REFRESH_PROGRESS")));
                        keyboard.add(List.of(createInlineButton("🏠 Меню квизов", "SHOW_QUIZ_MENU")));
                        markup.setKeyboard(keyboard);
                        
                        SendMessage msg = new SendMessage();
                        msg.setChatId(String.valueOf(chatId));
                        msg.setText(dashboardText);
                        msg.setParseMode("HTML");
                        msg.setReplyMarkup(markup);
                        Message sentMsg = execute(msg);
                        lastMenuMessageIds.put(chatId, sentMsg.getMessageId());
                    } catch (Exception e) {
                        try {
                            SendMessage errorMsg = new SendMessage();
                            errorMsg.setChatId(String.valueOf(chatId));
                            errorMsg.setText("⚠️ Ошибка загрузки профиля. Попробуй позже.");
                            Message sentError = execute(errorMsg);
                            lastMenuMessageIds.put(chatId, sentError.getMessageId());
                        } catch (TelegramApiException ex) {
                            // silently ignore
                        }
                    }
                } else if (text.equals("/settings")) {
                    AppUser user = userService.getOrCreateUser(telegramId, username);
                    boolean hasActiveSession = activeSessions.containsKey(chatId);
                    Message msg = sendSettingsMenu(chatId, user, null, hasActiveSession);
                    if (msg != null) {
                        lastMenuMessageIds.put(chatId, msg.getMessageId());
                    }
                } else {
                    activeSessions.remove(chatId);
                    Message msg = sendMessage(chatId, "Неизвестная команда. Попробуй выбрать действие из меню команд или напиши /start");
                    if (msg != null) {
                        lastMenuMessageIds.put(chatId, msg.getMessageId());
                    }
                }
            } else {
                UserState state = userStates.getOrDefault(chatId, UserState.DEFAULT);
                if (state == UserState.WAITING_FOR_WORD_EDIT || state == UserState.WAITING_FOR_TRANS_EDIT || state == UserState.WAITING_FOR_EXAMPLE_EDIT) {
                    PendingWord pending = pendingWords.get(chatId);
                    if (pending != null) {
                        if (state == UserState.WAITING_FOR_WORD_EDIT) {
                            if ("KG".equals(pending.getLang())) {
                                pending.setKgWord(text);
                            } else {
                                pending.setRuWord(text);
                            }
                        } else if (state == UserState.WAITING_FOR_TRANS_EDIT) {
                            if ("KG".equals(pending.getLang())) {
                                pending.setRuWord(text);
                            } else {
                                pending.setKgWord(text);
                            }
                        } else if (state == UserState.WAITING_FOR_EXAMPLE_EDIT) {
                            pending.setExampleKg(text);
                        }

                        try { execute(new DeleteMessage(String.valueOf(chatId), messageId)); } catch(TelegramApiException e){}
                        
                        Integer promptId = promptMessageIds.remove(chatId);
                        if (promptId != null) {
                            try { execute(new DeleteMessage(String.valueOf(chatId), promptId)); } catch(TelegramApiException e){}
                        }

                        userStates.put(chatId, UserState.DEFAULT);
                        sendEditMenu(chatId, pending);
                    } else {
                        userStates.put(chatId, UserState.DEFAULT);
                    }
                } else {
                    deleteSessionMessage(chatId);
                    clearLastMenuMessage(chatId);

                    List<Vocabulary> found = vocabularyRepository.findAll().stream()
                            .filter(v -> v.getWord().equalsIgnoreCase(text) || v.getTranslation().equalsIgnoreCase(text))
                            .toList();
                    if (!found.isEmpty()) {
                        Vocabulary vocab = found.get(0);
                        StringBuilder sb = new StringBuilder();
                        sb.append("✅ Слово найдено в базе:\n")
                          .append("<b>").append(vocab.getWord()).append("</b> — ").append(vocab.getTranslation());
                          
                        List<Example> examples = exampleRepository.findByVocabularyId(vocab.getId());
                        if (examples != null && !examples.isEmpty()) {
                            Example ex = examples.get(0);
                            sb.append("\n\n💡 Пример: <i>").append(ex.getKyrgyzText()).append("</i> — ").append(ex.getRussianTranslation());
                        }
                        
                        SendMessage msg = new SendMessage();
                        msg.setChatId(String.valueOf(chatId));
                        msg.setText(sb.toString());
                        msg.setParseMode("HTML");
                        
                        InlineKeyboardMarkup markup = new InlineKeyboardMarkup();
                        List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();
                        keyboard.add(List.of(createInlineButton("🔙 Вернуться", "CLOSE_DICTIONARY")));
                        markup.setKeyboard(keyboard);
                        msg.setReplyMarkup(markup);

                        try {
                            execute(msg);
                        } catch(TelegramApiException e) {}
                    } else {
                        Message waitMsg = sendMessage(chatId, "⏳ Анализирую слово и генерирую пример...");
                        if (waitMsg != null) {
                            PendingWord pending = aiDictionaryService.generateDictionaryEntry(text);
                            if (pending != null) {
                                pending.setMessageId(waitMsg.getMessageId());
                                pendingWords.put(chatId, pending);
                                sendResultCard(chatId, pending);
                            } else {
                                try {
                                    EditMessageText editMessage = new EditMessageText();
                                    editMessage.setChatId(String.valueOf(chatId));
                                    editMessage.setMessageId(waitMsg.getMessageId());
                                    editMessage.setText("❌ Ошибка при обращении к AI. Попробуйте позже.");
                                    execute(editMessage);
                                } catch (TelegramApiException e) {}
                            }
                        }
                    }
                }
            }
        } else if (update.hasCallbackQuery()) {
            CallbackQuery callbackQuery = update.getCallbackQuery();
            String data = callbackQuery.getData();
            Long chatId = callbackQuery.getMessage().getChatId();
            Integer messageId = callbackQuery.getMessage().getMessageId();
            Long telegramId = callbackQuery.getFrom().getId();
            String username = callbackQuery.getFrom().getUserName();

            userService.getOrCreateUser(telegramId, username);

            if ("CLOSE_DICTIONARY".equals(data)) {
                try {
                    EditMessageReplyMarkup edit = new EditMessageReplyMarkup();
                    edit.setChatId(String.valueOf(chatId));
                    edit.setMessageId(messageId);
                    edit.setReplyMarkup(new InlineKeyboardMarkup(new ArrayList<>()));
                    execute(edit);
                } catch (TelegramApiException e) {}

                if (activeSessions.containsKey(chatId)) {
                    handleResumeQuiz(chatId, telegramId, username);
                }

                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if ("IGNORE".equals(data)) {
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }
                return;
            }
            
            if ("REFRESH_PROGRESS".equals(data)) {
                try {
                    UserService.DashboardStats stats = userService.getDashboardStats(telegramId);
                    String dashboardText = generateProgressDashboard(stats);
                    
                    InlineKeyboardMarkup markup = new InlineKeyboardMarkup();
                    List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();
                    keyboard.add(List.of(createInlineButton("🔄 Обновить", "REFRESH_PROGRESS")));
                    keyboard.add(List.of(createInlineButton("🏠 Меню квизов", "SHOW_QUIZ_MENU")));
                    markup.setKeyboard(keyboard);
                    
                    EditMessageText edit = new EditMessageText();
                    edit.setChatId(String.valueOf(chatId));
                    edit.setMessageId(messageId);
                    edit.setText(dashboardText);
                    edit.setParseMode("HTML");
                    edit.setReplyMarkup(markup);
                    execute(edit);
                } catch (Exception e) {
                    try {
                        SendMessage errorMsg = new SendMessage();
                        errorMsg.setChatId(String.valueOf(chatId));
                        errorMsg.setText("⚠️ Ошибка загрузки профиля. Попробуй позже.");
                        Message sentError = execute(errorMsg);
                        lastMenuMessageIds.put(chatId, sentError.getMessageId());
                    } catch (TelegramApiException ex) {
                        // silently ignore
                    }
                }
                
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if ("RESUME_QUIZ".equals(data)) {
                try {
                    execute(new DeleteMessage(String.valueOf(chatId), messageId));
                } catch (TelegramApiException e) {
                    // silently ignore
                }
                clearLastMenuMessage(chatId);
                
                handleResumeQuiz(chatId, telegramId, username);
                
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }
                return;
            }

            if (data != null && data.equals("SHOW_QUIZ_MENU")) {
                try {
                    execute(new DeleteMessage(String.valueOf(chatId), messageId));
                } catch (TelegramApiException e) {
                    // silently ignore
                }
                clearLastMenuMessage(chatId);
                clearActiveSession(chatId);
                
                Message msg = sendQuizMenu(chatId);
                if (msg != null) {
                    lastMenuMessageIds.put(chatId, msg.getMessageId());
                }
                
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }
                return;
            }

            if (data != null && data.startsWith("SETTINGS_")) {
                if (data.equals("SETTINGS_DIR")) {
                    userService.toggleTranslationDirection(telegramId);
                } else if (data.equals("SETTINGS_DELAY")) {
                    userService.toggleRecallDelay(telegramId);
                } else if (data.equals("SETTINGS_LIMIT")) {
                    userService.toggleMaxSessionWords(telegramId);
                } else if (data.equals("SETTINGS_RESET")) {
                    userService.resetProgress(telegramId);
                    
                    AnswerCallbackQuery answer = new AnswerCallbackQuery();
                    answer.setCallbackQueryId(callbackQuery.getId());
                    try { execute(answer); } catch (Exception e) {} 
                    
                    EditMessageText edit = new EditMessageText();
                    edit.setChatId(String.valueOf(chatId));
                    edit.setMessageId(messageId);
                    edit.setText("✅ Ваш прогресс успешно сброшен!");
                    edit.setReplyMarkup(new InlineKeyboardMarkup(new ArrayList<>()));
                    try { execute(edit); } catch (Exception e) {}
                    return;
                }
                
                AppUser updatedUser = userService.getOrCreateUser(telegramId, username);
                boolean hasActiveSession = activeSessions.containsKey(chatId);
                sendSettingsMenu(chatId, updatedUser, messageId, hasActiveSession);
                
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }
                return;
            }

            if (data != null && data.startsWith("START_QUIZ_")) {
                try { 
                    execute(new DeleteMessage(String.valueOf(chatId), messageId)); 
                } catch (TelegramApiException e) { 
                    // silently ignore 
                }
                clearLastMenuMessage(chatId);
                clearActiveSession(chatId);

                int limit = Integer.parseInt(data.replace("START_QUIZ_", ""));

                String quizName = switch (limit) {
                    case 20 -> "🚀 Топ-20 слов";
                    case 50 -> "🔥 Топ-50 слов";
                    case 100 -> "🧠 Топ-100 слов";
                    case 500 -> "🏆 Топ-500 слов";
                    case 1000 -> "🌟 Топ-1000 слов";
                    case 2613 -> "👑 Топ-2000+ слов";
                    default -> "Тренировка";
                };
                
                Page<Vocabulary> page = vocabularyRepository.findAll(PageRequest.of(0, limit, Sort.by(Sort.Direction.ASC, "frequency")));
                List<Vocabulary> words = new ArrayList<>(page.getContent());
                
                AppUser user = userService.getOrCreateUser(telegramId, username);
                List<UserProgress> progressList = userProgressRepository.findByUser(user);
                
                java.util.Map<Long, Integer> wordAttempts = new java.util.HashMap<>();
                List<Vocabulary> unmasteredWords = new ArrayList<>();
                for (Vocabulary v : words) {
                    int correct = 0;
                    int wrong = 0;
                    for (UserProgress p : progressList) {
                        if (p.getVocabulary().getId().equals(v.getId())) {
                            correct = p.getCorrectAnswers();
                            wrong = p.getWrongAnswers();
                            break;
                        }
                    }
                    if ((correct - wrong) < 2) {
                        unmasteredWords.add(v);
                        wordAttempts.put(v.getId(), correct + wrong);
                    }
                }
                
                if (unmasteredWords.isEmpty()) {
                    String congratulationText = String.format("🎉 Поздравляю! Ты идеально выучил все слова из категории <b>%s</b>! Выбирай следующий уровень в /quiz.", quizName);
                    SendMessage congratulation = new SendMessage();
                    congratulation.setChatId(String.valueOf(chatId));
                    congratulation.setText(congratulationText);
                    congratulation.setParseMode("HTML");
                    try {
                        execute(congratulation);
                    } catch (TelegramApiException e) {
                        // silently ignore
                    }
                    
                    AnswerCallbackQuery answer = new AnswerCallbackQuery();
                    answer.setCallbackQueryId(callbackQuery.getId());
                    try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }
                    return;
                }
                
                unmasteredWords.sort((v1, v2) -> {
                    int attempts1 = wordAttempts.getOrDefault(v1.getId(), 0);
                    int attempts2 = wordAttempts.getOrDefault(v2.getId(), 0);
                    if (attempts1 != attempts2) {
                        return Integer.compare(attempts1, attempts2);
                    }
                    int freq1 = v1.getFrequency() != null ? v1.getFrequency() : Integer.MAX_VALUE;
                    int freq2 = v2.getFrequency() != null ? v2.getFrequency() : Integer.MAX_VALUE;
                    return Integer.compare(freq1, freq2);
                });

                int sessionLimit = user.getMaxSessionWords();
                if (sessionLimit > 0 && unmasteredWords.size() > sessionLimit) {
                    unmasteredWords = new ArrayList<>(unmasteredWords.subList(0, sessionLimit));
                }
                
                Collections.shuffle(unmasteredWords);

                QuizSession session = new QuizSession();
                session.queue.addAll(unmasteredWords);
                session.totalOriginalWords = unmasteredWords.size();
                session.quizName = quizName;
                session.quizLimit = limit;
                session.sessionMaxWords = sessionLimit;
                activeSessions.put(chatId, session);

                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }

                sendNextSessionQuestion(chatId, null, telegramId, username);
                return;
            }

            if (data != null && data.startsWith("Q_")) {
                if (data.equals("Q_END")) {
                    activeSessions.remove(chatId);
                    AppUser user = userService.getOrCreateUser(telegramId, username);
                    EditMessageText editMessage = new EditMessageText();
                    editMessage.setChatId(String.valueOf(chatId));
                    editMessage.setMessageId(messageId);
                    editMessage.setText("Тренировка завершена! Твой итоговый счет: " + user.getScore() + " ⭐");
                    editMessage.setReplyMarkup(new InlineKeyboardMarkup(new ArrayList<>()));
                    try {
                        execute(editMessage);
                    } catch (TelegramApiException e) {
                        // silently ignore
                    }
                } else {
                    String[] parts = data.split("_");
                    if (parts.length == 3) {
                        Long vocabId = Long.parseLong(parts[1]);
                        boolean isCorrect = parts[2].equals("1");

                        userService.updateProgress(telegramId, vocabId, isCorrect);
                        Vocabulary currentVocab = vocabularyRepository.findById(vocabId).orElse(null);

                        QuizSession session = activeSessions.get(chatId);
                        if (session == null) {
                            AnswerCallbackQuery answer = new AnswerCallbackQuery();
                            answer.setCallbackQueryId(callbackQuery.getId());
                            try { execute(answer); } catch (Exception e) { /* silently ignore */ }
                            return;
                        }

                        session.previousWord = currentVocab;
                        session.wasPreviousCorrect = isCorrect;

                        if (isCorrect) {
                            userService.addScore(telegramId, 1);
                            session.correctCount++;
                            session.sessionCorrectCount++;
                            if (!session.queue.isEmpty() && session.queue.get(0).getId().equals(vocabId)) {
                                session.queue.remove(0);
                            }
                        } else {
                            session.sessionWrongCount++;
                            if (!session.queue.isEmpty() && session.queue.get(0).getId().equals(vocabId)) {
                                Vocabulary failedWord = session.queue.remove(0);
                                session.queue.add(failedWord);
                            }
                        }

                        AnswerCallbackQuery answer = new AnswerCallbackQuery();
                        answer.setCallbackQueryId(callbackQuery.getId());
                        try { execute(answer); } catch (TelegramApiException e) { /* silently ignore */ }

                        sendNextSessionQuestion(chatId, messageId, telegramId, username);
                    }
                }
            }
            
            if (data != null && data.equals("SAVE_WORD")) {
                PendingWord pending = pendingWords.get(chatId);
                if (pending != null) {
                    Vocabulary vocab = new Vocabulary();
                    vocab.setWord(pending.getKgWord() != null ? pending.getKgWord() : "");
                    vocab.setTranslation(pending.getRuWord() != null ? pending.getRuWord() : "");
                    vocab.setType(pending.getType() != null ? String.valueOf(pending.getType()) : "0");
                    vocab.setFrequency(vocabularyRepository.findMaxFrequency() + 1);
                    vocab.setAuthor(String.valueOf(telegramId));

                    Example ex = new Example();
                    ex.setKyrgyzText(pending.getExampleKg() != null ? pending.getExampleKg() : "");
                    ex.setRussianTranslation(pending.getExampleRu() != null ? pending.getExampleRu() : "");
                    ex.setVocabulary(vocab);

                    vocab.setExamples(new ArrayList<>(List.of(ex)));

                    vocabularyRepository.save(vocab);

                    userStates.remove(chatId);
                    pendingWords.remove(chatId);

                    try {
                        String finalText = String.format("🤖 <b>Слово проанализировано:</b>\n\n🇰🇬 Кыргызский: <b>%s</b>\n🇷🇺 Русский: <b>%s</b>\n\n💡 Пример: <i>%s</i> — %s\n\n✅ <b>Сохранено в БД</b>",
                                pending.getKgWord(), pending.getRuWord(), pending.getExampleKg(), pending.getExampleRu());

                        EditMessageText edit = new EditMessageText();
                        edit.setChatId(String.valueOf(chatId));
                        edit.setMessageId(messageId);
                        edit.setText(finalText);
                        edit.setParseMode("HTML");
                        edit.setReplyMarkup(new InlineKeyboardMarkup(new ArrayList<>()));
                        execute(edit);
                    } catch (TelegramApiException e) {}
                    
                    if (activeSessions.containsKey(chatId)) {
                        handleResumeQuiz(chatId, telegramId, username);
                    }
                }
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if (data != null && data.equals("CANCEL_WORD")) {
                userStates.remove(chatId);
                PendingWord pending = pendingWords.remove(chatId);
                
                try {
                    if (pending != null) {
                        String finalText = String.format("🤖 <b>Слово проанализировано:</b>\n\n🇰🇬 Кыргызский: <b>%s</b>\n🇷🇺 Русский: <b>%s</b>\n\n💡 Пример: <i>%s</i> — %s\n\n❌ <b>Отменено</b>",
                                pending.getKgWord(), pending.getRuWord(), pending.getExampleKg(), pending.getExampleRu());
                        
                        EditMessageText edit = new EditMessageText();
                        edit.setChatId(String.valueOf(chatId));
                        edit.setMessageId(messageId);
                        edit.setText(finalText);
                        edit.setParseMode("HTML");
                        edit.setReplyMarkup(new InlineKeyboardMarkup(new ArrayList<>()));
                        execute(edit);
                    } else {
                        execute(new DeleteMessage(String.valueOf(chatId), messageId));
                    }
                } catch(TelegramApiException e){}
                
                if (activeSessions.containsKey(chatId)) {
                    handleResumeQuiz(chatId, telegramId, username);
                }
                
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if (data != null && data.equals("EDIT_WORD_MENU")) {
                PendingWord pending = pendingWords.get(chatId);
                if (pending != null) {
                    sendEditMenu(chatId, pending);
                }
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if (data != null && data.equals("EDIT_ORIGINAL")) {
                userStates.put(chatId, UserState.WAITING_FOR_WORD_EDIT);
                Message msg = sendMessage(chatId, "Отправь новое значение:");
                if (msg != null) promptMessageIds.put(chatId, msg.getMessageId());
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if (data != null && data.equals("EDIT_TRANSLATION")) {
                userStates.put(chatId, UserState.WAITING_FOR_TRANS_EDIT);
                Message msg = sendMessage(chatId, "Отправь новое значение:");
                if (msg != null) promptMessageIds.put(chatId, msg.getMessageId());
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }

            if (data != null && data.equals("EDIT_EXAMPLE")) {
                userStates.put(chatId, UserState.WAITING_FOR_EXAMPLE_EDIT);
                Message msg = sendMessage(chatId, "Отправь новое значение:");
                if (msg != null) promptMessageIds.put(chatId, msg.getMessageId());
                AnswerCallbackQuery answer = new AnswerCallbackQuery();
                answer.setCallbackQueryId(callbackQuery.getId());
                try { execute(answer); } catch (Exception e) {}
                return;
            }
        }
    }

    private Message sendSettingsMenu(Long chatId, AppUser user, Integer messageId, boolean hasActiveSession) {
        String text = "⚙️ <b>Настройки:</b>\nНастрой бота под себя!";
        
        InlineKeyboardMarkup markup = buildSettingsKeyboard(user, hasActiveSession);
        
        try {
            if (messageId != null) {
                EditMessageText edit = new EditMessageText();
                edit.setChatId(String.valueOf(chatId));
                edit.setMessageId(messageId);
                edit.setText(text);
                edit.setParseMode("HTML");
                edit.setReplyMarkup(markup);
                execute(edit);
                return null;
            } else {
                SendMessage message = new SendMessage();
                message.setChatId(String.valueOf(chatId));
                message.setText(text);
                message.setParseMode("HTML");
                message.setReplyMarkup(markup);
                return execute(message);
            }
        } catch (TelegramApiException e) {
            // silently ignore
        }
        return null;
    }

    private InlineKeyboardMarkup buildSettingsKeyboard(AppUser user, boolean hasActiveSession) {
        List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();
        
        String dirText = switch(user.getTranslationDirection()) {
            case "RU_KG" -> "🔄 Направление: Рус➔Кырг ✅";
            case "MIXED" -> "🔄 Направление: Микс ✅";
            default -> "🔄 Направление: Кырг➔Рус ✅";
        };
        keyboard.add(List.of(createInlineButton(dirText, "SETTINGS_DIR")));
        
        String delayText = switch(user.getRecallDelaySeconds()) {
            case 0 -> "⏱ Пауза: Выкл ✅";
            case 1 -> "⏱ Пауза: 1 сек ✅";
            case 3 -> "⏱ Пауза: 3 сек ✅";
            case 5 -> "⏱ Пауза: 5 сек ✅";
            default -> "⏱ Пауза: 2 сек ✅";
        };
        keyboard.add(List.of(createInlineButton(delayText, "SETTINGS_DELAY")));
        
        String limitText = switch(user.getMaxSessionWords()) {
            case 0 -> "📦 Порция: Без лимита ✅";
            case 20 -> "📦 Порция: 20 слов ✅";
            case 30 -> "📦 Порция: 30 слов ✅";
            default -> "📦 Порция: 10 слов ✅";
        };
        keyboard.add(List.of(createInlineButton(limitText, "SETTINGS_LIMIT")));
        
        keyboard.add(List.of(createInlineButton("🗑 Сбросить весь прогресс", "SETTINGS_RESET")));
        
        if (hasActiveSession) {
            keyboard.add(List.of(createInlineButton("🔙 Вернуться к тренировке", "RESUME_QUIZ")));
        }
        
        InlineKeyboardMarkup markup = new InlineKeyboardMarkup();
        markup.setKeyboard(keyboard);
        return markup;
    }

    private Message sendQuizMenu(Long chatId) {
        SendMessage message = new SendMessage();
