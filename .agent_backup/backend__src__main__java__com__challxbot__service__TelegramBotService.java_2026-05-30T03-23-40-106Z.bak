        keyboard.add(List.of(createInlineButton("🧠 Топ-100 слов", "START_QUIZ_100")));
        keyboard.add(List.of(createInlineButton("🏆 Топ-500 слов", "START_QUIZ_500")));
        keyboard.add(List.of(createInlineButton("🌟 Топ-1000 слов", "START_QUIZ_1000")));
