package com.challxbot.service;

import com.challxbot.domain.AppUser;
import com.challxbot.domain.Vocabulary;
import com.challxbot.repository.VocabularyRepository;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.telegram.telegrambots.bots.TelegramLongPollingBot;
import org.telegram.telegrambots.meta.api.methods.AnswerCallbackQuery;
import org.telegram.telegrambots.meta.api.methods.send.SendMessage;
import org.telegram.telegrambots.meta.api.methods.updatingmessages.DeleteMessage;
import org.telegram.telegrambots.meta.api.methods.updatingmessages.EditMessageText;
import org.telegram.telegrambots.meta.api.objects.CallbackQuery;
import org.telegram.telegrambots.meta.api.objects.Message;
import org.telegram.telegrambots.meta.api.objects.Update;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.InlineKeyboardMarkup;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.ReplyKeyboardMarkup;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.buttons.InlineKeyboardButton;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.buttons.KeyboardRow;
import org.telegram.telegrambots.meta.exceptions.TelegramApiException;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@Service
public class TelegramBotService extends TelegramLongPollingBot {

    private final String botUsername;
    private final VocabularyRepository vocabularyRepository;
    private final UserService userService;
    private final Map<Long, Integer> welcomeMessages = new ConcurrentHashMap<>();

    public TelegramBotService(
            @Value("${telegram.bot.token}") String botToken,
            @Value("${telegram.bot.username}") String botUsername,
            VocabularyRepository vocabularyRepository,
            UserService userService) {
        super(botToken);
        this.botUsername = botUsername;
        this.vocabularyRepository = vocabularyRepository;
        this.userService = userService;
    }

    @Override
    public String getBotUsername() {
        return botUsername;
    }

    @Override
    public void onUpdateReceived(Update update) {
        if (update.hasMessage() && update.getMessage().hasText()) {
            Message message = update.getMessage();
            Long chatId = message.getChatId();
            Integer messageId = message.getMessageId();
            Long telegramId = message.getFrom().getId();
            String username = message.getFrom().getUserName();
            String text = message.getText();

            // Удаляем любое текстовое сообщение пользователя для чистоты чата
            try {
                execute(new DeleteMessage(String.valueOf(chatId), messageId));
            } catch (TelegramApiException e) {
                e.printStackTrace();
            }

            userService.getOrCreateUser(telegramId, username);

            if (text.equals("/start")) {
                long count = vocabularyRepository.count();
                Message msg = sendMainMenu(chatId,
                        "Привет! Я твой помощник в изучении кыргызского языка 🇰🇬\nВ моей базе уже " + count
                                + " слов!\n\nВыбери действие в меню ниже 👇");
                if (msg != null) {
                    welcomeMessages.put(chatId, msg.getMessageId());
                }
            } else if (text.equals("/quiz") || text.equals("🚀 Учить слова")) {
                // Удаляем старое приветствие (если оно было)
                Integer welcomeId = welcomeMessages.remove(chatId);
                if (welcomeId != null) {
                    try {
                        execute(new DeleteMessage(String.valueOf(chatId), welcomeId));
                    } catch (TelegramApiException e) {
                        e.printStackTrace();
                    }
                }
                sendOrEditQuizQuestion(chatId, null, telegramId, username, null);
            } else if (text.equals("📊 Мой прогресс")) {
                UserService.UserStatistics stats = userService.getUserStatistics(telegramId);
                
                StringBuilder sb = new StringBuilder();
                sb.append("📊 <b>Твоя статистика:</b>\n\n");
                sb.append("⭐ Общий счет: ").append(stats.totalScore()).append("\n");
                sb.append("📚 Изучено слов: ").append(stats.learnedWordsCount()).append("\n");
                sb.append("✅ Верных ответов: ").append(stats.totalCorrect()).append("\n");
                sb.append("❌ Ошибок: ").append(stats.totalWrong()).append("\n");
                sb.append("🎓 Твой уровень: ").append(stats.level()).append("\n");
                
                if (stats.hardestWords() != null && !stats.hardestWords().isEmpty()) {
                    sb.append("\n⚠️ <b>Топ-").append(stats.hardestWords().size()).append(" сложных слов:</b>\n");
                    for (Vocabulary v : stats.hardestWords()) {
                        sb.append("— ").append(v.getWord()).append(" - ").append(v.getTranslation()).append("\n");
                    }
                }
                
                SendMessage msg = new SendMessage();
                msg.setChatId(String.valueOf(chatId));
                msg.setText(sb.toString());
                msg.setParseMode("HTML");
                try {
                    execute(msg);
                } catch (TelegramApiException e) {
                    e.printStackTrace();
                }
            } else if (text.equals("⚙️ Настройки")) {
                sendMessage(chatId, "Настройки скоро появятся!");
            } else {
                sendMessage(chatId, "Неизвестная команда. Попробуй выбрать действие из меню или напиши /quiz");
            }
        } else if (update.hasCallbackQuery()) {
            CallbackQuery callbackQuery = update.getCallbackQuery();
            String data = callbackQuery.getData();
            Long chatId = callbackQuery.getMessage().getChatId();
            Integer messageId = callbackQuery.getMessage().getMessageId();
            Long telegramId = callbackQuery.getFrom().getId();
            String username = callbackQuery.getFrom().getUserName();

            userService.getOrCreateUser(telegramId, username);

            if (data != null && data.startsWith("Q_")) {
                if (data.equals("Q_END")) {
                    AppUser user = userService.getOrCreateUser(telegramId, username);
                    EditMessageText editMessage = new EditMessageText();
                    editMessage.setChatId(String.valueOf(chatId));
                    editMessage.setMessageId(messageId);
                    editMessage.setText("Тренировка завершена! Твой итоговый счет: " + user.getScore() + " ⭐");
                    editMessage.setReplyMarkup(new InlineKeyboardMarkup(new ArrayList<>())); // Убираем клавиатуру
                    try {
                        execute(editMessage);
                    } catch (TelegramApiException e) {
                        e.printStackTrace();
                    }
                } else {
                    String[] parts = data.split("_");
                    if (parts.length == 3) {
                        Long vocabId = Long.parseLong(parts[1]);
                        boolean isCorrect = parts[2].equals("1");

                        userService.updateProgress(telegramId, vocabId, isCorrect);

                        Vocabulary currentVocab = vocabularyRepository.findById(vocabId).orElse(null);

                        String toastText;
                        if (isCorrect) {
                            userService.addScore(telegramId, 1);
                            toastText = "✅ Верно!";
                        } else {
                            String correctAnswer = currentVocab != null ? currentVocab.getTranslation() : "неизвестно";
                            toastText = "❌ Ошибка! Правильно: " + correctAnswer;
                        }

                        AnswerCallbackQuery answer = new AnswerCallbackQuery();
                        answer.setCallbackQueryId(callbackQuery.getId());
                        answer.setText(toastText);
                        answer.setShowAlert(false);

                        try {
                            execute(answer);
                        } catch (TelegramApiException e) {
                            e.printStackTrace();
                        }

                        // Бесшовный бесконечный квиз: сразу генерируем следующий вопрос
                        sendOrEditQuizQuestion(chatId, messageId, telegramId, username, currentVocab);
                    }
                }
            }
        }
    }

    private Message sendMainMenu(Long chatId, String text) {
        SendMessage message = new SendMessage();
        message.setChatId(String.valueOf(chatId));
        message.setText(text);

        ReplyKeyboardMarkup keyboardMarkup = new ReplyKeyboardMarkup();
        keyboardMarkup.setResizeKeyboard(true);
        List<KeyboardRow> keyboard = new ArrayList<>();

        KeyboardRow row1 = new KeyboardRow();
        row1.add("🚀 Учить слова");

        KeyboardRow row2 = new KeyboardRow();
        row2.add("📊 Мой прогресс");
        row2.add("⚙️ Настройки");

        keyboard.add(row1);
        keyboard.add(row2);

        keyboardMarkup.setKeyboard(keyboard);
        message.setReplyMarkup(keyboardMarkup);

        try {
            // Возвращаем объект Message, чтобы можно было получить его ID и удалить позже
            return execute(message);
        } catch (TelegramApiException e) {
            e.printStackTrace();
        }
        return null;
    }

    private void sendMessage(Long chatId, String text) {
        SendMessage message = new SendMessage();
        message.setChatId(String.valueOf(chatId));
        message.setText(text);
        try {
            execute(message);
        } catch (TelegramApiException e) {
            e.printStackTrace();
        }
    }

    private void sendOrEditQuizQuestion(Long chatId, Integer messageId, Long telegramId, String username,
            Vocabulary previousWord) {
        AppUser user = userService.getOrCreateUser(telegramId, username);
        int score = user.getScore();

        Vocabulary correctVocab = userService.getNextWordForUser(telegramId, 100);
        if (correctVocab == null) {
            sendMessage(chatId, "В базе недостаточно слов.");
            return;
        }

        userService.recordWordShown(telegramId, correctVocab.getId());

        List<Vocabulary> allWords = vocabularyRepository.findAll();
        Collections.shuffle(allWords);

        List<Vocabulary> trapWords = new ArrayList<>();
        for (Vocabulary v : allWords) {
            if (!v.getId().equals(correctVocab.getId())) {
                trapWords.add(v);
                if (trapWords.size() == 3) {
                    break;
                }
            }
        }

        if (trapWords.size() < 3) {
            sendMessage(chatId, "В базе недостаточно слов для генерации ловушек (нужно минимум 4).");
            return;
        }

        List<AnswerOption> options = new ArrayList<>();
        options.add(new AnswerOption(correctVocab.getTranslation(), true));
        for (Vocabulary trap : trapWords) {
            options.add(new AnswerOption(trap.getTranslation(), false));
        }
        Collections.shuffle(options);

        List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();

        for (int i = 0; i < options.size(); i++) {
            AnswerOption opt = options.get(i);
            InlineKeyboardButton btn = new InlineKeyboardButton();
            // ЗАГЛАВНЫЕ БУКВЫ для крупного текста
            btn.setText(opt.text.toUpperCase());
            btn.setCallbackData("Q_" + correctVocab.getId() + "_" + (opt.isCorrect ? "1" : "0"));
            // КАЖДАЯ КНОПКА В СВОЕМ РЯДУ
            keyboard.add(List.of(btn));
        }

        InlineKeyboardButton endBtn = new InlineKeyboardButton();
        endBtn.setText("🏁 ЗАКОНЧИТЬ ТРЕНИРОВКУ");
        endBtn.setCallbackData("Q_END");
        keyboard.add(List.of(endBtn));

        InlineKeyboardMarkup markup = new InlineKeyboardMarkup();
        markup.setKeyboard(keyboard);

        // Верстка сообщения с разделителем
        StringBuilder sb = new StringBuilder();
        sb.append("\n\n🏆 Твой счет: ").append(score).append(" ⭐\n");
        if (previousWord != null) {
            sb.append("✅ Прошлое: <b>").append(previousWord.getWord()).append("</b> — ")
                    .append(previousWord.getTranslation()).append("\n");
            sb.append("💡 Пример: Скоро здесь будут примеры использования\n");
            sb.append("➖➖➖➖➖➖➖➖➖➖\n\n");
        } else {
            sb.append("\n");
        }
        sb.append("🔹 <b>").append(correctVocab.getWord()).append("</b> 🔹");

        String text = sb.toString();

        try {
            if (messageId != null) {
                EditMessageText editMessage = new EditMessageText();
                editMessage.setChatId(String.valueOf(chatId));
                editMessage.setMessageId(messageId);
                editMessage.setText(text);
                editMessage.setParseMode("HTML");
                editMessage.setReplyMarkup(markup);
                execute(editMessage);
            } else {
                SendMessage message = new SendMessage();
                message.setChatId(String.valueOf(chatId));
                message.setText(text);
                message.setParseMode("HTML");
                message.setReplyMarkup(markup);
                execute(message);
            }
        } catch (TelegramApiException e) {
            e.printStackTrace();
        }
    }

    private static class AnswerOption {
        String text;
        boolean isCorrect;

        AnswerOption(String text, boolean isCorrect) {
            this.text = text;
            this.isCorrect = isCorrect;
        }
    }
}
