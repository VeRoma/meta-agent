package com.challxbot.service;

import com.challxbot.domain.AppUser;
import com.challxbot.domain.UserProgress;
import com.challxbot.domain.Vocabulary;
import com.challxbot.repository.AppUserRepository;
import com.challxbot.repository.UserProgressRepository;
import com.challxbot.repository.VocabularyRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Random;
import java.util.stream.Collectors;

@Service
public class UserService {

    private final AppUserRepository userRepository;
    private final UserProgressRepository userProgressRepository;
    private final VocabularyRepository vocabularyRepository;

    public UserService(AppUserRepository userRepository, UserProgressRepository userProgressRepository, VocabularyRepository vocabularyRepository) {
        this.userRepository = userRepository;
        this.userProgressRepository = userProgressRepository;
        this.vocabularyRepository = vocabularyRepository;
    }

    @Transactional
    public AppUser getOrCreateUser(Long telegramId, String username) {
        return userRepository.findByTelegramId(telegramId)
                .orElseGet(() -> {
                    AppUser newUser = new AppUser();
                    newUser.setTelegramId(telegramId);
                    newUser.setUsername(username);
                    newUser.setScore(0);
                    return userRepository.save(newUser);
                });
    }

    @Transactional
    public void addScore(Long telegramId, int points) {
        userRepository.findByTelegramId(telegramId).ifPresent(user -> {
            user.setScore(user.getScore() + points);
            userRepository.save(user);
        });
    }

    @Transactional
    public void updateProgress(Long telegramId, Long vocabularyId, boolean isCorrect) {
        AppUser user = userRepository.findByTelegramId(telegramId).orElse(null);
        Vocabulary vocab = vocabularyRepository.findById(vocabularyId).orElse(null);

        if (user != null && vocab != null) {
            UserProgress progress = userProgressRepository.findByUserAndVocabulary(user, vocab)
                    .orElseGet(() -> {
                        UserProgress p = new UserProgress();
                        p.setUser(user);
                        p.setVocabulary(vocab);
                        p.setCorrectAnswers(0);
                        p.setWrongAnswers(0);
                        p.setShowsKgToRu(0);
                        p.setShowsRuToKg(0);
                        return p;
                    });

            if (isCorrect) {
                progress.setCorrectAnswers(progress.getCorrectAnswers() + 1);
            } else {
                progress.setWrongAnswers(progress.getWrongAnswers() + 1);
            }

            userProgressRepository.save(progress);
        }
    }

    @Transactional
    public void recordWordShown(Long telegramId, Long vocabId) {
        AppUser user = userRepository.findByTelegramId(telegramId).orElse(null);
        Vocabulary vocab = vocabularyRepository.findById(vocabId).orElse(null);

        if (user != null && vocab != null) {
            UserProgress progress = userProgressRepository.findByUserAndVocabulary(user, vocab)
                    .orElseGet(() -> {
                        UserProgress p = new UserProgress();
                        p.setUser(user);
                        p.setVocabulary(vocab);
                        p.setCorrectAnswers(0);
                        p.setWrongAnswers(0);
                        p.setShowsKgToRu(0);
                        p.setShowsRuToKg(0);
                        return p;
                    });

            progress.setShowsKgToRu(progress.getShowsKgToRu() + 1);
            progress.setLastShownAt(LocalDateTime.now());
            userProgressRepository.save(progress);
        }
    }

    @Transactional(readOnly = true)
    public Vocabulary getNextWordForUser(Long telegramId, int topFrequencyLimit) {
        AppUser user = userRepository.findByTelegramId(telegramId).orElse(null);
        if (user == null) {
            List<Vocabulary> all = vocabularyRepository.findAll();
            return all.isEmpty() ? null : all.get(new Random().nextInt(all.size()));
        }

        List<UserProgress> userProgressList = userProgressRepository.findByUser(user);
        List<Vocabulary> topWords = vocabularyRepository.findByFrequencyBetween(1, topFrequencyLimit);
        if (topWords.isEmpty()) {
            topWords = vocabularyRepository.findAll();
        }

        if (topWords.isEmpty()) {
            return null;
        }

        List<Long> seenVocabIds = userProgressList.stream()
                .map(p -> p.getVocabulary().getId())
                .collect(Collectors.toList());

        // a) Сначала новые слова
        List<Vocabulary> newWords = topWords.stream()
                .filter(v -> !seenVocabIds.contains(v.getId()))
                .collect(Collectors.toList());

        if (!newWords.isEmpty()) {
            return newWords.get(new Random().nextInt(newWords.size()));
        }

        // b) Если новых нет, берем слова с ошибками с кулдауном 5 минут
        LocalDateTime fiveMinsAgo = LocalDateTime.now().minusMinutes(5);
        List<UserProgress> availableProgress = userProgressList.stream()
                .filter(p -> p.getLastShownAt() == null || p.getLastShownAt().isBefore(fiveMinsAgo))
                .collect(Collectors.toList());

        if (!availableProgress.isEmpty()) {
            // c) Выбираем слово с наибольшим количеством wrongAnswers
            UserProgress wordToReview = availableProgress.stream()
                    .max((p1, p2) -> Integer.compare(p1.getWrongAnswers(), p2.getWrongAnswers()))
                    .orElse(availableProgress.get(new Random().nextInt(availableProgress.size())));
            return wordToReview.getVocabulary();
        }

        // d) Если все слова в кулдауне, берем случайное
        return topWords.get(new Random().nextInt(topWords.size()));
    }
}
