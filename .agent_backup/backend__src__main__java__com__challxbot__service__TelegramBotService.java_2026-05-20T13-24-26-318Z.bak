package com.challxbot.service;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.telegram.telegrambots.bots.TelegramLongPollingBot;
import org.telegram.telegrambots.meta.api.methods.send.SendMessage;
import org.telegram.telegrambots.meta.api.objects.CallbackQuery;
import org.telegram.telegrambots.meta.api.objects.Update;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.InlineKeyboardMarkup;
import org.telegram.telegrambots.meta.api.objects.replykeyboard.buttons.InlineKeyboardButton;
import org.telegram.telegrambots.meta.exceptions.TelegramApiException;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

@Slf4j
@Service
public class TelegramBotService extends TelegramLongPollingBot {

    @Value("${telegram.bot.username}")
    private String botUsername;

    private final TelegramValidationService telegramValidationService;
    private final GeminiService geminiService;
    private final ObjectMapper objectMapper;

    public TelegramBotService(@Value("${telegram.bot.token}") String botToken,
                              TelegramValidationService telegramValidationService,
                              GeminiService geminiService,
                              ObjectMapper objectMapper) {
        super(botToken);
        this.telegramValidationService = telegramValidationService;
        this.geminiService = geminiService;
        this.objectMapper = objectMapper;
    }

    @Override
    public String getBotUsername() {
        return botUsername;
    }

    @Override
    public void onUpdateReceived(Update update) {
        if (update.hasMessage() && update.getMessage().hasText()) {
            String messageText = update.getMessage().getText();
            long chatId = update.getMessage().getChatId();

            if (messageText.equals("/start")) {
                sendMessage(chatId, "Добро пожаловать в квиз по кыргызскому языку! Введите /quiz, чтобы начать.");
            } else if (messageText.equals("/quiz")) {
                sendQuizQuestion(chatId);
            }
        } else if (update.hasCallbackQuery()) {
            CallbackQuery callbackQuery = update.getCallbackQuery();
            long chatId = callbackQuery.getMessage().getChatId();
            String data = callbackQuery.getData();

            if ("CORRECT".equals(data)) {
                sendMessage(chatId, "✅ Правильно!");
            } else if ("WRONG".equals(data)) {
                sendMessage(chatId, "❌ Ошибка!");
            }

            // Бесконечный квиз: сразу отправляем следующий вопрос
            sendQuizQuestion(chatId);
        }
    }

    private void sendQuizQuestion(long chatId) {
        try {
            // Запрашиваем JSON у GeminiService (предполагаемый метод генерации)
            String jsonResponse = geminiService.generateQuiz("Кыргызский язык", 1);
            log.info("Получен JSON от Gemini в TelegramBotService: {}", jsonResponse);

            // Парсим JSON
            JsonNode rootNode = objectMapper.readTree(jsonResponse);
            
            // Если ответ пришел массивом, берем первый элемент (т.к. запрашивали 1 вопрос)
            JsonNode quizNode = rootNode;
            if (rootNode.isArray()) {
                if (rootNode.isEmpty()) {
                    log.error("Ошибка парсинга квиза: Gemini вернул пустой JSON-массив.");
                    sendMessage(chatId, "Произошла ошибка (пустой ответ от ИИ). Попробуйте снова: /quiz");
                    return;
                }
                quizNode = rootNode.get(0);
            }

            // Проверяем наличие новых ключей: question, options, correctIndex
            if (!quizNode.has("question") || !quizNode.has("options") || !quizNode.has("correctIndex")) {
                log.error("Ошибка парсинга квиза: JSON не содержит обязательных полей (question, options, correctIndex). Узел: {}", quizNode);
                sendMessage(chatId, "Ошибка структуры вопроса от ИИ. Попробуйте снова: /quiz");
                return;
            }

            String question = quizNode.get("question").asText();
            int correctIndex = quizNode.get("correctIndex").asInt();
            JsonNode optionsNode = quizNode.get("options");

            if (!optionsNode.isArray() || optionsNode.size() == 0) {
                log.error("Ошибка парсинга квиза: Поле options не является массивом или пустое: {}", optionsNode);
                sendMessage(chatId, "Ошибка в вариантах ответа. Попробуйте снова: /quiz");
                return;
            }

            // Подготавливаем варианты
            List<AnswerOption> options = new ArrayList<>();
            for (int i = 0; i < optionsNode.size(); i++) {
                String optionText = optionsNode.get(i).asText();
                String callbackData = (i == correctIndex) ? "CORRECT" : "WRONG";
                options.add(new AnswerOption(optionText, callbackData));
            }
            
            // Перемешиваем варианты (callbackData жестко привязан к правильному тексту, поэтому это безопасно)
            Collections.shuffle(options);

            // Создаем InlineKeyboardMarkup (1 столбец)
            InlineKeyboardMarkup markup = new InlineKeyboardMarkup();
            List<List<InlineKeyboardButton>> keyboard = new ArrayList<>();
            for (AnswerOption option : options) {
                InlineKeyboardButton button = new InlineKeyboardButton();
                button.setText(option.text);
                button.setCallbackData(option.callbackData);
                List<InlineKeyboardButton> row = new ArrayList<>();
                row.add(button);
                keyboard.add(row);
            }
            markup.setKeyboard(keyboard);

            SendMessage message = new SendMessage();
            message.setChatId(String.valueOf(chatId));
            message.setText("❓ *" + question + "*");
            message.setParseMode("Markdown");
            message.setReplyMarkup(markup);

            execute(message);

        } catch (Exception e) {
            log.error("Ошибка при генерации, парсинге или отправке вопроса. Трейс:", e);
            sendMessage(chatId, "Произошла ошибка при создании вопроса. Попробуйте снова: /quiz");
        }
    }

    private void sendMessage(long chatId, String text) {
        SendMessage message = new SendMessage();
        message.setChatId(String.valueOf(chatId));
        message.setText(text);
        try {
            execute(message);
        } catch (TelegramApiException e) {
            log.error("Не удалось отправить сообщение", e);
        }
    }

    private static class AnswerOption {
        String text;
        String callbackData;

        AnswerOption(String text, String callbackData) {
            this.text = text;
            this.callbackData = callbackData;
        }
    }
}
