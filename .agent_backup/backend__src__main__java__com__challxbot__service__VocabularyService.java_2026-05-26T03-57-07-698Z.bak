package com.challxbot.service;

import com.challxbot.domain.Vocabulary;
import com.challxbot.repository.VocabularyRepository;
import com.opencsv.CSVReader;
import jakarta.annotation.PostConstruct;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.io.ClassPathResource;
import org.springframework.stereotype.Service;

import java.io.InputStreamReader;
import java.io.Reader;
import java.nio.charset.StandardCharsets;

@Service
@Slf4j
@RequiredArgsConstructor
public class VocabularyService {

    private final VocabularyRepository vocabularyRepository;

    @PostConstruct
    public void initDictionary() {
        log.info("Загрузка словаря из dictionary.csv...");
        try (Reader reader = new InputStreamReader(new ClassPathResource("dictionary.csv").getInputStream(), StandardCharsets.UTF_8);
             CSVReader csvReader = new CSVReader(reader)) {

            String[] line;
            boolean isHeader = true;

            while ((line = csvReader.readNext()) != null) {
                if (isHeader) {
                    isHeader = false;
                    continue; // Пропускаем заголовок (word,translation,type,frequency,author)
                }

                if (line.length >= 5) {
                    String word = line[0].trim();
                    String translation = line[1].trim();
                    String type = line[2].trim();
                    
                    Integer frequency = 999;
                    try {
                        if (!line[3].trim().isEmpty()) {
                            frequency = Integer.parseInt(line[3].trim());
                        }
                    } catch (NumberFormatException e) {
                        // Игнорируем ошибку парсинга, оставляем 999
                    }
                    
                    String author = line[4].trim();

                    if (!word.isEmpty() && !vocabularyRepository.existsByWord(word)) {
                        Vocabulary vocab = Vocabulary.builder()
                                .word(word)
                                .translation(translation)
                                .type(type)
                                .frequency(frequency)
                                .author(author)
                                .build();
                        vocabularyRepository.save(vocab);
                    }
                }
            }
            log.info("Словарь успешно загружен.");
        } catch (Exception e) {
            log.error("Ошибка при чтении dictionary.csv", e);
        }
    }
}
